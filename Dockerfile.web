FROM node:22-alpine
WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install dependencies
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy application source & public assets
COPY . .

# Build Vite production bundle
RUN pnpm build

EXPOSE 8443

# Serve static SPA bundle rewrite to index.html with dynamic $PORT support
CMD npx -y serve -s dist -l ${PORT:-8443}
